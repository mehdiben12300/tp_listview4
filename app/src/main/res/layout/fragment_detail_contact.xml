<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_contact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Barre d'outils avec bouton retour et bouton supprimer -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_purple"
        app:title="@string/title_detail"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:menu="@menu/menu_detail"
        android:elevation="4dp" />

    <!-- Formulaire scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Section Photo avec Badge Caméra -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPhoto"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:id="@+id/ivDetailPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        android:contentDescription="Photo du contact" />
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/ivCameraBadge"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignEnd="@id/cardPhoto"
                    android:layout_alignBottom="@id/cardPhoto"
                    android:background="@drawable/bg_circle_camera"
                    android:padding="7dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white"
                    android:contentDescription="Prendre une photo" />
            </RelativeLayout>

            <!-- Champ Nom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_nom"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etNom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_nom"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName|textCapWords"
                android:layout_marginBottom="14dp" />

            <!-- Champ Prénom -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_prenom"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPrenom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/hint_prenom"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:inputType="textPersonName|textCapWords"
                android:layout_marginBottom="14dp" />

            <!-- Champ Téléphone + Bouton Appeler (Intent implicite) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_telephone"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/etTelephone"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_telephone"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:inputType="phone" />

                <ImageButton
                    android:id="@+id/btnAppeler"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_call"
                    android:src="@drawable/ic_call"
                    app:tint="@color/white"
                    android:contentDescription="@string/btn_appeler" />
            </LinearLayout>

            <!-- Champ E-mail + Bouton Envoyer e-mail (Intent implicite) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_email"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:inputType="textEmailAddress" />

                <ImageButton
                    android:id="@+id/btnEmail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_email"
                    android:src="@drawable/ic_email"
                    app:tint="@color/white"
                    android:contentDescription="@string/btn_email" />
            </LinearLayout>

            <!-- Boutons Photo : Galerie et Caméra -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChoisirPhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_photo"
                    app:backgroundTint="@color/purple_action"
                    android:text="@string/btn_choisir_photo"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_gallery"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrendrePhoto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_photo"
                    app:backgroundTint="@color/purple_action"
                    android:text="@string/btn_prendre_photo"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- 6. Section Coordonnées GPS et Google Maps -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/blue_action"
                            android:contentDescription="Position GPS" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/label_coordonnees_gps"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Latitude -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_latitude"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/etLatitude"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_field"
                                android:hint="@string/hint_latitude"
                                android:inputType="numberSigned|numberDecimal"
                                android:paddingHorizontal="10dp"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <!-- Longitude -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_longitude"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/etLongitude"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_input_field"
                                android:hint="@string/hint_longitude"
                                android:inputType="numberSigned|numberDecimal"
                                android:paddingHorizontal="10dp"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Bouton Voir sur la carte -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoirSurCarte"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_map"
                        app:backgroundTint="@color/blue_action"
                        android:text="@string/btn_voir_carte"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_map"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bouton Enregistrer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnregistrer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_btn_save"
                app:backgroundTint="@color/green_action"
                android:text="@string/btn_enregistrer"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:layout_marginBottom="10dp" />

            <!-- Bouton Annuler -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnnuler"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_annuler"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
