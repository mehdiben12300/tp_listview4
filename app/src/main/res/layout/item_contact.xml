<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_contact_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:id="@+id/layoutContactContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:duplicateParentState="true">

        <!-- Photo de profil avec découpe circulaire -->
        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent">

            <ImageView
                android:id="@+id/ivItemPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_avatar"
                android:contentDescription="Photo de profil" />
        </androidx.cardview.widget.CardView>

        <!-- Nom, Prénom, Téléphone et indicateur GPS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvItemNomPrenom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom Prénom"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tvItemTelephone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06 12 34 56 78"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <!-- Badge discret si le contact a des coordonnées GPS -->
                <TextView
                    android:id="@+id/tvItemGpsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="📍 GPS"
                    android:textColor="@color/blue_action"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bouton Appeler : visible seulement si la préférence appel_depuis_liste est activée -->
        <ImageButton
            android:id="@+id/btnItemAppeler"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_call"
            android:src="@drawable/ic_call"
            app:tint="@color/white"
            android:visibility="gone"
            android:contentDescription="@string/btn_appeler" />

        <!-- Chevron navigation -->
        <ImageView
            android:id="@+id/ivItemChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_secondary"
            android:contentDescription="Ouvrir le détail" />

    </LinearLayout>

    <!-- Ligne de séparation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"
        android:layout_marginStart="84dp" />

</LinearLayout>
