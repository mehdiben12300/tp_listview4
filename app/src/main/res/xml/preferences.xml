<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_categorie_affichage">

        <ListPreference
            app:key="taille_police"
            app:title="@string/pref_taille_police"
            app:entries="@array/tailles_libelles"
            app:entryValues="@array/tailles_valeurs"
            app:defaultValue="16"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="couleur_preferee"
            app:title="@string/pref_couleur_preferee"
            app:entries="@array/couleurs_libelles"
            app:entryValues="@array/couleurs_valeurs"
            app:defaultValue="@string/couleur_defaut"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_categorie_liste">

        <ListPreference
            app:key="ordre_tri"
            app:title="@string/pref_ordre_tri"
            app:entries="@array/ordres_tri_libelles"
            app:entryValues="@array/ordres_tri_valeurs"
            app:defaultValue="favoris"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="appel_depuis_liste"
            app:title="@string/pref_appel_depuis_liste"
            app:summaryOn="@string/pref_appel_resume_oui"
            app:summaryOff="@string/pref_appel_resume_non"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
